---
import '../styles/global.css';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;

const siteUrl = canonical || 'https://johndoe.com/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
  </head>
  <body>
    <div id="preloader" class="preloader">
      <div class="preloader-top"></div>
      <div class="preloader-bottom"></div>
      <span class="preloader-name">SAMUZ</span>
    </div>

    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
  }

  .preloader-top,
  .preloader-bottom {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    background: #000;
    transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .preloader-top {
    top: 0;
  }

  .preloader-bottom {
    bottom: 0;
  }

  .preloader--hide .preloader-top {
    transform: translateY(-100%);
  }

  .preloader--hide .preloader-bottom {
    transform: translateY(100%);
  }

  .preloader-name {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(0.875rem, 1.5vw, 1.1rem);
    font-weight: 400;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    z-index: 1;
    transition: opacity 0.3s ease-out;
  }

  .preloader--hide .preloader-name {
    opacity: 0;
  }
</style>
