---
import HiganbanaThree from '@/components/HiganbanaThree.astro';

interface Props {
  name: string;
  subtitle: string;
  summary: string;
  email: string;
}
const { name, subtitle, summary, email } = Astro.props;
---
<section id="top" class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-text">
        <p class="hero-label animate-entrance">Portfolio</p>

        <h1 class="hero-title animate-entrance animate-entrance-delay-1">
          <span>{name}</span>
          <br />
          <span class="hero-title-accent">{subtitle}</span>
        </h1>

        <p class="hero-bio animate-entrance animate-entrance-delay-2">{summary}</p>

        <div class="hero-actions animate-entrance animate-entrance-delay-3">
          <a href="#works" class="btn">View Work</a>
          <a href={`mailto:${email}`} class="btn btn-secondary">Contact</a>
        </div>
      </div>

      <div class="hero-visual animate-entrance animate-entrance-delay-2">
        <HiganbanaThree name={name.toUpperCase()} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(230, 57, 70, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
    padding-top: 4rem;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
  }

  .hero-title {
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
  }

  .hero-title-accent {
    color: var(--color-fg-muted);
    font-weight: 300;
    font-style: italic;
  }

  .hero-bio {
    font-size: var(--text-body);
    color: var(--color-fg-muted);
    line-height: 1.8;
    margin-bottom: var(--space-xl);
    max-width: 32rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 500px;
  }

  @media (min-width: 768px) {
    .hero-visual {
      min-height: 600px;
    }
  }

  @media (min-width: 1200px) {
    .hero-visual {
      min-height: 700px;
    }
  }

  @media (max-width: 767px) {
    .hero-visual {
      min-height: 400px;
    }
  }
</style>