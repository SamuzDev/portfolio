---
interface Props {
  title: string;
  subtitle?: string;
  children: any;
  class?: string;
}
const { title, subtitle, children, class: className = '' } = Astro.props;
---
<section class:list={['section', className]}>
  <div class="container">
    <header class="section-header mb-12">
      <div>
        <h2 class="section-title">{title}</h2>
        {subtitle && <p class="section-subtitle mt-2">{subtitle}</p>}
      </div>
    </header>
    <div>{children}</div>
  </div>
</section>
