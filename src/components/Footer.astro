---
import { getTranslations, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();

const socialLinks = [
  { name: 'Dribbble', url: 'https://dribbble.com/johndoe', icon: 'dribbble' },
  { name: 'Behance', url: 'https://behance.net/johndoe', icon: 'behance' },
  { name: 'GitHub', url: 'https://github.com/johndoe', icon: 'github' },
  { name: 'CodePen', url: 'https://codepen.io/johndoe', icon: 'codepen' },
  { name: 'LinkedIn', url: 'https://linkedin.com/in/johndoe', icon: 'linkedin' },
  { name: 'Instagram', url: 'https://instagram.com/johndoe', icon: 'instagram' },
  { name: 'Facebook', url: 'https://facebook.com/johndoe', icon: 'facebook' },
];

const icons: Record<string, string> = {
  dribbble: '<circle cx="12" cy="12" r="10"></circle><path d="M19.13 5.09C15.22 9.14 10 10.44 2.25 10.94"></path><path d="M21.75 12.84c-6.62-1.41-12.14 1-16.38 6.32"></path><path d="M8.56 2.75c4.32 2 8.48 5.48 12 11.19"></path>',
  behance: '<path d="M1 12.5h7.5c1.93 0 3.5-1.57 3.5-3.5S10.43 5.5 8.5 5.5H1v7zm0 0v7h8c2.21 0 4-1.79 4-4s-1.79-4-4-4H1"></path><path d="M15.5 12.5h5.5v1.5h-5.5zm0-3h5c2.49 0 4.5 2.01 4.5 4.5S22.99 15.5 20.5 15.5h-5v-6zm2.5 4.5c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5h-1v3h1z"></path>',
  github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>',
  codepen: '<polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon><line x1="12" y1="22" x2="12" y2="15.5"></line><polyline points="22 8.5 12 15.5 2 8.5"></polyline><polyline points="2 15.5 12 8.5 22 15.5"></polyline><line x1="12" y1="2" x2="12" y2="8.5"></line>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle>',
  instagram: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>',
  facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>',
};
---
<footer class="cta-section">
  <!-- CTA Block -->
  <div class="container" style="padding-top: clamp(4rem, 8vw, 8rem); padding-bottom: clamp(4rem, 8vw, 6rem); position: relative;">
    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 3rem; flex-wrap: wrap;">
      <div style="max-width: 600px;">
        <h2 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 1.5rem;">
          Let's work together.
        </h2>
        <p style="color: var(--color-fg-muted); font-size: 1rem; margin-bottom: 2.5rem; line-height: 1.6;">
          I'm available for freelance work.
        </p>
        <a href={`mailto:john@gmail.com`} class="btn">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--color-border); flex-shrink: 0;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </span>
          SAY HELLO
        </a>
      </div>

      <div class="deco-circle" style="flex-shrink: 0; margin-top: 1rem;"></div>
    </div>
  </div>

  <!-- Footer Bar -->
  <div class="container" style="border-top: 1px solid var(--color-border); padding-top: 1.5rem; padding-bottom: 1.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
      <p style="font-size: 0.875rem; color: var(--color-fg-subtle);">
        &copy; {year} John Doe
      </p>

      <nav style="display: flex; align-items: center; gap: 1.25rem;" aria-label="Social links">
        {socialLinks.map(social => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            style={`color: var(--color-fg-subtle); transition: color 0.2s;`}
            aria-label={social.name}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[social.icon]} />
          </a>
        ))}
      </nav>

      <a
        href="#top"
        style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; color: var(--color-fg-subtle); transition: color 0.2s; text-decoration: none; opacity: 0.7;"
        class="no-print"
        onmouseenter="this.style.color='var(--color-fg)'; this.style.opacity='1'"
        onmouseleave="this.style.color='var(--color-fg-subtle)'; this.style.opacity='0.7'"
      >
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" width="32" height="32">
          <text x="20" y="28" text-anchor="middle" fontFamily="'Inter', system-ui, sans-serif" fontSize="16" fontWeight="700" letterSpacing="-0.02em" fill="currentColor">JG</text>
        </svg>
      </a>
    </div>
  </div>
</footer>
