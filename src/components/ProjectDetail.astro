---
import { getTranslations } from '@/lib/i18n';

interface Props {
  project: {
    slug: string;
    number: string;
    title: string;
    category: string;
    cover: string;
    images: string[];
    metadata: {
      platform: string;
      category: string;
      designer: string;
      tools: string[];
    };
    description: string;
    behanceUrl: string | null;
    githubUrl: string | null;
  };
}
const { project } = Astro.props;
const t = getTranslations();

const title = `${project.title} — John Doe`;
const description = project.description;
const canonical = `https://johndoe.com/projects/${project.slug}/`;
---
<article class="project-detail">
  <header class="project-header">
    <span class="project-index">{project.number}</span>
    <h1 class="project-title">{project.title}</h1>
    <p class="project-category">{project.metadata.category}</p>
  </header>

  {project.images.length > 0 && (
    <div class="project-images">
      {project.images.map((image, i) => (
        <img src={image} alt={`${project.title} ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
    </div>
  )}

  <div class="project-content">
    <section class="project-about">
      <h2>{t.project.about}</h2>
      <p>{project.description}</p>
    </section>

    <section class="project-meta">
      <dl>
        <div>
          <dt>{t.project.platform}</dt>
          <dd>{project.metadata.platform}</dd>
        </div>
        <div>
          <dt>{t.project.category}</dt>
          <dd>{project.metadata.category}</dd>
        </div>
        <div>
          <dt>{t.project.designer}</dt>
          <dd>{project.metadata.designer}</dd>
        </div>
        <div>
          <dt>{t.project.tools}</dt>
          <dd>{project.metadata.tools.join(', ')}</dd>
        </div>
      </dl>
    </section>

    <div class="project-links">
      {project.behanceUrl && (
        <a href={project.behanceUrl} target="_blank" rel="noopener noreferrer" class="btn">
          View on Behance
        </a>
      )}
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          View on GitHub
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-detail {
    padding: var(--space-xl) 0;
  }

  .project-header {
    max-width: 42rem;
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: block;
    margin-bottom: var(--space-sm);
  }

  .project-title {
    font-size: var(--text-h1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--space-xs);
  }

  .project-category {
    font-size: var(--text-body);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-images {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .project-images img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .project-content {
    max-width: 42rem;
    margin: 0 auto;
  }

  .project-about {
    margin-bottom: var(--space-xl);
  }

  .project-about h2 {
    font-size: var(--text-h3);
    margin-bottom: var(--space-md);
  }

  .project-about p {
    font-size: var(--text-body);
    color: var(--color-fg-muted);
    line-height: 1.8;
  }

  .project-meta {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .project-meta dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm) var(--space-lg);
  }

  .project-meta dt {
    font-size: var(--text-tiny);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .project-meta dd {
    font-size: var(--text-body);
    color: var(--color-fg);
    margin: 0;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }
</style>