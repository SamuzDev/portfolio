---
interface Props {
  modelUrl?: string;
}
const { modelUrl = '/models/26ugbsku.glb' } = Astro.props;
---

<div class="hero-canvas-wrapper">
  <canvas id="higanbana-canvas" class="hero-canvas" aria-label="Higanbana 3D model" width="800" height="600"></canvas>
</div>

<script is:inline>
(function() {
  var preloader = document.getElementById('preloader');

  function hidePreloader() {
    if (preloader && !preloader.classList.contains('preloader--hide')) {
      preloader.classList.add('preloader--hide');
      setTimeout(function() { preloader.remove(); }, 800);
    }
  }

  // Hard fallback: 4s max
  setTimeout(hidePreloader, 4000);

  window.signalModelLoaded = function() {
    setTimeout(hidePreloader, 300);
  };
})();
</script>

<script type="module">
  import { initHiganbana } from '@/three/HiganbanaScene';

  const canvas = document.getElementById('higanbana-canvas');
  if (!canvas || (window).__higanbanaLoaded) {
    window.signalModelLoaded && window.signalModelLoaded();
  } else {
    (window).__higanbanaLoaded = true;

    try {
      const result = await initHiganbana({
        canvas,
        modelUrl: '/models/26ugbsku.glb',
        isMobile: window.innerWidth < 768,
        prefersReducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
        onProgress: function() {},
      });

      if (result.success) {
        canvas.style.opacity = '1';
      } else {
        canvas.style.display = 'none';
      }
    } catch (e) {
      console.error(e);
      canvas.style.display = 'none';
    }

    window.signalModelLoaded && window.signalModelLoaded();
  }
</script>

<style>
  .hero-canvas-wrapper {
    position: relative;
    width: 100%;
    min-height: 500px;
    overflow: hidden;
  }
  @media (min-width: 768px) { .hero-canvas-wrapper { min-height: 600px; } }
  @media (min-width: 1200px) { .hero-canvas-wrapper { min-height: 700px; } }
  @media (max-width: 767px) { .hero-canvas-wrapper { min-height: 400px; } }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-canvas-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0, 0, 0, 0.15) 100%);
    pointer-events: none;
    z-index: 1;
  }
</style>
