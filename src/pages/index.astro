---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { getResume } from '@/lib/resume';
import { getFeaturedProjects } from '@/lib/projects';
import { getTranslations } from '@/lib/i18n';

const resume = await getResume();
const featuredProjects = getFeaturedProjects(6);
const { basics } = resume;
const t = getTranslations('en');

const title = `${basics.name} — ${basics.label}`;
const description = basics.summary;
const canonical = 'https://johndoe.com/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Hero
    name={basics.name}
    subtitle={t.hero.subtitle}
    summary={basics.summary}
    email={basics.email}
  />

  <!-- About Section -->
  <section id="about" class="section" aria-labelledby="about-title">
    <div class="container">
      <h2 id="about-title" class="section-title animate-entrance">
        {t.about.title}
      </h2>
      <p class="about-desc animate-entrance animate-entrance-delay-1">
        {t.about.description}
      </p>
    </div>
  </section>

  <!-- Works Section -->
  <section id="works" class="section" aria-labelledby="works-title">
    <div class="container">
      <div class="section-header">
        <p class="section-label animate-entrance">Selected Work</p>
        <h2 id="works-title" class="section-title animate-entrance animate-entrance-delay-1">
          {t.works.title}
        </h2>
        <p class="section-desc animate-entrance animate-entrance-delay-2">
          {t.works.description}
        </p>
      </div>
      <div class="projects-grid">
        {featuredProjects.map((project, i) => (
          <article class={`project-card animate-entrance animate-entrance-delay-${Math.min(i + 2, 5)}`}>
            <a href={`/projects/${project.slug}`} class="project-card-link">
              <div class="project-card-header">
                <span class="project-index">{project.number}</span>
                <span class="project-category">{project.metadata.category}</span>
              </div>
              <h3 class="project-title">{project.title}</h3>
              <div class="project-card-footer">
                <span class="project-platform">{project.metadata.platform}</span>
                <svg class="project-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact-content">
        <h2 id="contact-title" class="contact-title animate-entrance">
          Let's work together.
        </h2>
        <p class="contact-desc animate-entrance animate-entrance-delay-1">
          I'm currently available for freelance work. Whether you have a project in mind
          or just want to say hello, I'd love to hear from you.
        </p>
        <a href={`mailto:${basics.email}`} class="btn animate-entrance animate-entrance-delay-2">
          Say Hello
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: clamp(4rem, 10vw, 8rem) 0;
  }

  .section-header {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto var(--space-xl);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--color-fg);
    margin-bottom: var(--space-md);
  }

  .section-label {
    font-size: var(--text-tiny);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-xs);
    display: block;
  }

  .section-desc {
    font-size: var(--text-body);
    color: var(--color-fg-muted);
    line-height: 1.7;
  }

  .about-desc {
    font-size: var(--text-body);
    color: var(--color-fg-muted);
    line-height: 1.9;
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-md);
    margin-top: var(--space-md);
    max-width: 42rem;
  }

  /* Project Cards Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  .project-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }

  .project-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .project-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--color-fg-subtle);
  }

  .project-category {
    font-size: var(--text-tiny);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-bg-hover);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .project-title {
    font-size: var(--text-h4);
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: var(--space-lg);
    flex-grow: 1;
  }

  .project-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .project-platform {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-arrow {
    width: 20px;
    height: 20px;
    color: var(--color-fg-subtle);
    transition: transform var(--transition-fast), color var(--transition-fast);
    flex-shrink: 0;
  }

  .project-card:hover .project-arrow {
    transform: translateX(4px);
    color: var(--color-fg);
  }

  .contact-content {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.15;
    color: var(--color-fg);
    margin-bottom: var(--space-md);
  }

  .contact-desc {
    font-size: var(--text-body);
    color: var(--color-fg-muted);
    line-height: 1.9;
    margin-bottom: var(--space-lg);
  }
</style>