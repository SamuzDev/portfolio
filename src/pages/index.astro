---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { getResume } from '@/lib/resume';
import { getFeaturedProjects } from '@/lib/projects';
import { getTranslations } from '@/lib/i18n';

const resume = await getResume();
const featuredProjects = getFeaturedProjects(6);
const { basics } = resume;
const t = getTranslations('en');

const title = `${basics.name} — ${basics.label}`;
const description = basics.summary;
const canonical = 'https://johndoe.com/';
---
<BaseLayout title={title} description={description} locale="en" canonical={canonical}>
  <Hero
    locale="en"
    name={basics.name}
    subtitle={basics.label}
    summary={basics.summary}
    email={basics.email}
  />

  <!-- About Section -->
  <section id="about" class="section animate-on-scroll fade-in" aria-labelledby="about-title">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr; gap: var(--space-lg); align-items: start;">
        <div class="animate-on-scroll fade-in delay-1">
          <p class="section-label">About me</p>
          <h2 id="about-title" class="section-title">I craft digital experiences that matter.</h2>
          <p class="section-desc">
            A passionate UI/UX Designer and Front End Developer with a keen eye for detail
            and a love for creating clean, user-friendly interfaces. I turn complex problems
            into simple, beautiful solutions.
          </p>
        </div>
        <div class="stats-grid">
          <div class="stat-card animate-on-scroll scale-in delay-1">
            <div class="stat-number">8+</div>
            <div class="stat-label">Years Experience</div>
          </div>
          <div class="stat-card animate-on-scroll scale-in delay-2">
            <div class="stat-number">50+</div>
            <div class="stat-label">Projects Completed</div>
          </div>
          <div class="stat-card animate-on-scroll scale-in delay-3">
            <div class="stat-number">30+</div>
            <div class="stat-label">Happy Clients</div>
          </div>
          <div class="stat-card animate-on-scroll scale-in delay-4">
            <div class="stat-number">15+</div>
            <div class="stat-label">Awards Won</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="section animate-on-scroll fade-in" style="background: var(--color-bg-elevated);" aria-labelledby="skills-title">
    <div class="container">
      <header class="section-header">
        <p class="section-label animate-on-scroll fade-in delay-1">What I Do</p>
        <h2 id="skills-title" class="section-title animate-on-scroll fade-in delay-2">Skills & Expertise</h2>
      </header>
      <div class="skills-list">
        <span class="skill-pill animate-on-scroll scale-in delay-1">UI/UX Design</span>
        <span class="skill-pill animate-on-scroll scale-in delay-2">React</span>
        <span class="skill-pill animate-on-scroll scale-in delay-3">TypeScript</span>
        <span class="skill-pill animate-on-scroll scale-in delay-4">Next.js</span>
        <span class="skill-pill animate-on-scroll scale-in delay-5">Figma</span>
        <span class="skill-pill animate-on-scroll scale-in delay-6">Tailwind CSS</span>
        <span class="skill-pill animate-on-scroll scale-in delay-7">Node.js</span>
        <span class="skill-pill animate-on-scroll scale-in delay-8">Astro</span>
        <span class="skill-pill animate-on-scroll scale-in delay-9">Motion Design</span>
        <span class="skill-pill animate-on-scroll scale-in delay-10">Responsive Design</span>
      </div>
    </div>
  </section>

  <!-- Works/Projects Section -->
  <section id="works" class="section animate-on-scroll fade-in" aria-labelledby="works-title">
    <div class="container">
      <header class="section-header">
        <p class="section-label animate-on-scroll fade-in delay-1">Selected Works</p>
        <h2 id="works-title" class="section-title animate-on-scroll fade-in delay-2">Recent Projects</h2>
      </header>
      <div class="projects-list">
        {featuredProjects.map((project, index) => (
          <a
            href={`/projects/${project.slug}`}
            class="project-row animate-on-scroll slide-up"
            style="--delay: {index * 0.05}s; transition-delay: var(--delay);"
          >
            <div class="project-info">
              <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
              <div class="project-meta">
                <h3 class="project-title">{project.title}</h3>
                <p class="project-category">{project.category}</p>
              </div>
            </div>
            <svg class="project-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section animate-on-scroll fade-in" style="background: var(--color-bg-elevated);" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact-content">
        <p class="section-label animate-on-scroll fade-in delay-1">Get in touch</p>
        <h2 id="contact-title" class="section-title animate-on-scroll fade-in delay-2">Let's work together.</h2>
        <p class="section-desc animate-on-scroll fade-in delay-3">
          I'm currently available for freelance work. Whether you have a project in mind
          or just want to say hello, I'd love to hear from you.
        </p>
        <div class="contact-actions animate-on-scroll fade-in delay-4">
          <a href={`mailto:${basics.email}`} class="btn btn-primary">
            Say Hello
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            LinkedIn
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
