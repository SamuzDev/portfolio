---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectDetail from '@/components/ProjectDetail.astro';
import { getProjectBySlug, getAllProjectSlugs } from '@/lib/projects';
import { getTranslations } from '@/lib/i18n';

export async function getStaticPaths() {
  const slugs = getAllProjectSlugs();
  return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug as string);
const t = getTranslations();

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const title = `${project.title} — John Doe`;
const description = project.description;
const canonical = `https://johndoe.com/projects/${project.slug}/`;
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <ProjectDetail project={project} />
</BaseLayout>